# CEDE environment template
# Copie este arquivo para `.env` no ambiente desejado e preencha apenas com valores reais
# fora do Git. Nunca versione senhas, tokens, chaves SMTP, credenciais de banco ou
# secrets do reCAPTCHA.

# ============================================================================
# 1) Bootstrap e runtime
# ============================================================================

# Ambiente principal da aplicação.
# Aceitos pelo runtime: production | development | test | local | dev | qa | homolog
# Importante: `qa` e `homolog` sao tratados como development-like.
# Para uma homologacao que precise espelhar producao, prefira `APP_ENV=production`
# com infraestrutura isolada.
APP_ENV=production

# Ambiente implantado exibido no painel administrativo.
# Aceitos: development | homolog | production
# Use isso para separar a etiqueta visual do ambiente do modo tecnico de runtime.
# Exemplo importante: homologacao pre-producao pode usar `APP_ENV=production`
# e ainda assim exibir corretamente `Homologacao` no painel com:
# APP_DEPLOY_STAGE="homolog"
# Opcionalmente, voce pode sobrescrever o texto exibido:
# APP_DEPLOY_STAGE_LABEL="Homologacao"

# Caminho alternativo para carregar um arquivo de ambiente diferente do `.env`.
# Exemplo: APP_ENV_FILE="/var/www/cedern/.env.production"
# APP_ENV_FILE=""

# Caminho do arquivo de log da aplicação.
# Em hospedagens compartilhadas, normalmente aponta para uma pasta fora do projeto.
# Exemplo Hostinger: /home/usuario/logs/app.log
# APP_LOG_PATH="/home/usuario/logs/app.log"

# Politica de fallback dos repositorios MySQL.
# Em development/test/local o fallback e permitido por padrao.
# Em production o padrao recomendado agora e estrito.
# APP_ALLOW_REPOSITORY_FALLBACK="false"

# Sinalizador opcional para execução em container.
# Quando verdadeiro, o logger pode preferir stdout.
# docker="false"

# Base path da aplicação.
# Use vazio quando o app roda na raiz do domínio: https://cedern.org/
# Use um subdiretório quando o app roda abaixo da raiz: /cedern
# Se `APP_BASE` ficar vazio, o bootstrap tenta autodetectar o subdiretório
# a partir de `SCRIPT_NAME` e ignora o sufixo `/public` de instalações reescritas.
# Mesmo assim, em produção o ideal continua sendo declarar o valor final explicitamente.
# Desenvolvimento atual: APP_BASE="/cedern"
# Produção final: APP_BASE=""
APP_BASE=""

# Root opcional para todos os uploads gerenciados fora da pasta publicada.
# Quando definido, os diretórios padrão abaixo passam a resolver para:
# - biblioteca docs: {ROOT}/library/docs
# - biblioteca capas: {ROOT}/library/covers
# - livraria capas: {ROOT}/bookshop/covers
# - fotos de membros: {ROOT}/member-photos
# - patrimonio docs/img: {ROOT}/patrimony/{docs|img}
# APP_MANAGED_STORAGE_ROOT="/home/usuario/cedern-storage"
# Quando definido, qualquer caminho relativo em var/storage/... passa a sair desse root.

# Origem explícita e exclusiva dos pacotes .zip usados por /health/storage/import.
# Se ficar vazia, o importador volta ao modo de descoberta automática.
# Exemplo recomendado em produção:
# APP_MANAGED_STORAGE_IMPORT_ARCHIVE_DIR="/home/usuario/cedern-storage/imports/managed-storage-zips"

# Fallback legado de leitura para fotos de membros ainda salvas em `public/assets/...`.
# Livraria, biblioteca e patrimonio mantem compatibilidade legada de leitura
# enquanto a migracao completa desses buckets nao for auditada no ambiente.
# APP_ENABLE_LEGACY_MEDIA_FALLBACK="false"

# Uploads do controle patrimonial.
# Por padrão, os arquivos ficam em `var/storage/patrimony/...` e são servidos por `/media/patrimonio/...`,
# o que evita dependência de escrita direta em `public/assets` em hospedagens como Hostinger.
# PATRIMONY_DOCUMENT_UPLOAD_DIR="var/storage/patrimony/docs"
# PATRIMONY_DOCUMENT_UPLOAD_PUBLIC_PREFIX="media/patrimonio/docs"
# PATRIMONY_IMAGE_UPLOAD_DIR="var/storage/patrimony/img"
# PATRIMONY_IMAGE_UPLOAD_PUBLIC_PREFIX="media/patrimonio/img"

# Versionador manual de assets para forçar renovação de CSS/JS/favicon após deploy.
# Troque o valor sempre que precisar quebrar cache público.
APP_ASSET_VERSION="1"


# ============================================================================
# 2) Aparência e seletor de tema
# ============================================================================

# Tema base aplicado antes de qualquer preferência salva no navegador.
# Aceitos: amber | blue | green | red | violet
APP_DEFAULT_THEME=amber

# Modo base da interface.
# Aceitos: light | dark
APP_DEFAULT_MODE=light

# Intensidade padrão do modo escuro.
# Aceitos: neutral | vivid
APP_DEFAULT_DARK_INTENSITY=neutral

# Lista de temas que o seletor pode oferecer.
# Se houver só um tema permitido, o seletor de tema se recolhe sozinho.
APP_THEME_ALLOWED_THEMES="amber,blue,green,red,violet"

# Lista de modos disponíveis no seletor.
APP_THEME_ALLOWED_MODES="light,dark"

# Intensidades disponíveis quando o modo dark está liberado.
APP_THEME_ALLOWED_DARK_INTENSITIES="neutral,vivid"

# Liga/desliga o seletor no site público.
# Quando falso, o site respeita apenas os defaults do `.env`.
APP_ENABLE_THEME_PALETTE="false"

# Liga/desliga o seletor no dashboard administrativo.
APP_ENABLE_DASHBOARD_THEME_PALETTE="true"


# ============================================================================
# 3) Metadados institucionais e redes sociais
# ============================================================================

# Título padrão usado em SEO, Open Graph e páginas que não sobrescrevem o title.
APP_DEFAULT_PAGE_TITLE="CEDE | Centro de Estudos da Doutrina Espírita"

# Descrição padrão usada em SEO, Open Graph e compartilhamentos.
APP_DEFAULT_PAGE_DESCRIPTION="Centro de Estudos da Doutrina Espírita (CEDE): instituição filantrópica dedicada ao estudo, à prática e à divulgação da Doutrina Espírita."

# URL pública canônica do site.
# Desenvolvimento atual: https://srv798468.hstgr.cloud/cedern/
# Produção final: https://cedern.org/
APP_DEFAULT_PAGE_URL="https://cedern.org/"

# Imagem padrão para Open Graph / Twitter Card.
APP_DEFAULT_PAGE_IMAGE="https://cedern.org/assets/img/cedern/cede1_1600_1000.png"

# Nome institucional exibido em og:site_name e em templates auxiliares.
APP_DEFAULT_SITE_NAME="CEDE"

# Perfil usado em metadados do Twitter/X.
APP_DEFAULT_TWITTER_SITE="@cedeoficialrn"

# Redes sociais exibidas no rodapé e em áreas institucionais.
APP_SOCIAL_FACEBOOK_URL="https://www.facebook.com/cedern.oficial/"
APP_SOCIAL_INSTAGRAM_URL="https://www.instagram.com/cedern.oficial/"


# ============================================================================
# 4) Agenda pública e rotas de diagnóstico
# ============================================================================

# Quantidade máxima de eventos exibidos na agenda pública.
# O código limita internamente esse valor entre 1 e 100.
APP_AGENDA_PUBLIC_LIMIT="12"

# Habilita rotas auxiliares de diagnóstico/inspeção.
# Mantenha false em produção.
APP_ENABLE_DIAGNOSTIC_ROUTES="false"

# Token exigido pelas rotas diagnosticas fora de ambientes de desenvolvimento.
# Quando APP_ENABLE_DIAGNOSTIC_ROUTES=true em producao, configure este token e envie
# via query string `?token=...` ou header `X-Diagnostic-Token`.
# APP_DIAGNOSTIC_TOKEN="seu_token_diagnostico"


# ============================================================================
# 5) reCAPTCHA
# ============================================================================

# Habilita validação do reCAPTCHA nos formulários protegidos.
RECAPTCHA_ENABLED="false"

# Chave pública usada no frontend.
# RECAPTCHA_SITE_KEY="sua_site_key"

# Chave secreta usada na validação do backend.
# RECAPTCHA_SECRET_KEY="sua_secret_key"

# Nota mínima aceitável para validação.
# Baseline operacional atual para reCAPTCHA v3: 0.1.
# Se a produção estabilizar bem, revise com cautela para 0.2 ou 0.3.
RECAPTCHA_MIN_SCORE="0.1"

# Hostname esperado no token validado.
# Em produção, normalmente o domínio final: cedern.org
# RECAPTCHA_ALLOWED_HOSTNAME="cedern.org"


# ============================================================================
# 6) Banco de dados MySQL
# ============================================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=seu_banco
DB_USER=seu_usuario
DB_PASS="sua_senha"
DB_CHARSET=utf8mb4
DB_TIMEZONE=+00:00


# ============================================================================
# 7) Acesso auxiliar do Admin Agenda
# ============================================================================

# Credenciais de Basic Auth para rotas protegidas do módulo de agenda.
ADMIN_AGENDA_USER=admin
ADMIN_AGENDA_PASS="sua_senha_forte"


# ============================================================================
# 8) E-mail transacional (contrato atual MAIL_*)
# ============================================================================

# SMTP principal usado por contato, cadastro e recuperação de senha.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contato@seudominio.com
MAIL_PASSWORD="sua_senha_smtp"

# Remetente visível no e-mail.
MAIL_FROM_ADDRESS=contato@seudominio.com
MAIL_FROM_NAME="CEDE - Contato"

# Destinatário institucional das notificações.
MAIL_TO_ADDRESS=contato@seudominio.com

# E-mail público exibido no site.
# Se omitido, o código usa MAIL_TO_ADDRESS e depois MAIL_FROM_ADDRESS.
MAIL_PUBLIC_EMAIL=contato@seudominio.com

# Criptografia SMTP.
# Aceitos na prática atual: ssl | tls | vazio
MAIL_ENCRYPTION=ssl

# Timeout do PHPMailer em segundos.
MAIL_TIMEOUT="15"

# Habilita debug SMTP verboso no log.
MAIL_SMTP_DEBUG="false"

# Permite usar Reply-To externo informado pelo visitante.
# Em produção, o padrão mais seguro é false.
MAIL_ALLOW_EXTERNAL_REPLYTO="false"


# ============================================================================
# 9) Gateway de cobrança Asaas
# ============================================================================

# Ambiente da API: sandbox | production
ASAAS_ENVIRONMENT=sandbox

# Proteção adicional: impede usar a API de produção do Asaas quando `APP_ENV`
# não for de produção. Só ligue isso se você realmente quiser romper a cerca.
ASAAS_ALLOW_PRODUCTION_IN_NON_PRODUCTION="false"

# Chave de API do Asaas.
# Atenção: aqui entra a API Key do Asaas, não o login/senha do painel.
# Se vazia, o módulo de contribuições continua operando sem emissão externa.
ASAAS_API_KEY="sua_api_key"

# Token opcional para validar o webhook recebido do Asaas.
# Webhook em desenvolvimento: https://srv798468.hstgr.cloud/cedern/webhooks/asaas/contribuicoes
# Webhook em produção: https://cedern.org/webhooks/asaas/contribuicoes
ASAAS_WEBHOOK_TOKEN="sua_webhook_token"

# Identificação do integrador nas requisições.
ASAAS_USER_AGENT="cedern-finance/1.0"

# Controla se o Asaas pode enviar notificações próprias ao cliente.
# false: o Asaas envia e-mail/WhatsApp/SMS conforme a configuração do cliente na base do Asaas.
# true: o Asaas fica silencioso e o SISCEDE/CEDE assume os lembretes por conta própria.
ASAAS_CUSTOMER_NOTIFICATION_DISABLED="true"


# ============================================================================
# 10) Uploads e armazenamento público
# ============================================================================

# Documentos da biblioteca.
LIBRARY_UPLOAD_DIR="var/storage/library/docs"
LIBRARY_UPLOAD_PUBLIC_PREFIX="media/biblioteca/docs"

# Capas da biblioteca.
LIBRARY_COVER_UPLOAD_DIR="var/storage/library/covers"
LIBRARY_COVER_UPLOAD_PUBLIC_PREFIX="media/biblioteca/capas"

# Capas da livraria.
BOOKSHOP_COVER_UPLOAD_DIR="var/storage/bookshop/covers"
BOOKSHOP_COVER_UPLOAD_PUBLIC_PREFIX="media/livraria/capas"

# Fotos de perfil dos membros.
# MEMBER_PROFILE_PHOTO_UPLOAD_DIR="var/storage/member-photos"
# MEMBER_PROFILE_PHOTO_UPLOAD_PUBLIC_PREFIX="media/membros/fotos"
