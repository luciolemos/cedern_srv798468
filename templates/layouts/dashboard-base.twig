<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set page_title = page_title|default(app_default_page_title|default('Dashboard | CEDE')) %}
  {% set page_description = page_description|default(app_default_page_description|default('Área interna administrativa.')) %}
  {% set page_url = page_url|default(app_default_page_url|default('https://cedern.org/dashboard')) %}
  {% set page_image = page_image|default(app_default_page_image|default('https://cedern.org/assets/img/cedern/cede1_1600_1000.png')) %}
  {% set site_name = site_name|default(app_default_site_name|default('CEDE')) %}
  {% set twitter_site = twitter_site|default(app_default_twitter_site|default('@cedeoficialrn')) %}
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_description }}">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ page_description }}">
  <meta property="og:url" content="{{ page_url }}">
  <meta property="og:image" content="{{ page_image }}">
  <meta property="og:site_name" content="{{ site_name }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="pt_BR">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title }}">
  <meta name="twitter:description" content="{{ page_description }}">
  <meta name="twitter:image" content="{{ page_image }}">
  <meta name="twitter:site" content="{{ twitter_site }}">
  <meta name="cedern-release-marker" content="flow-test-20260711-01">
  {% include 'components/theme-head-config.twig' with { theme_palette_enabled: app_dashboard_theme_palette_enabled|default(true) } %}
  <script>
    (function () {
      try {
        var root = document.documentElement;
        var defaultTheme = '{{ default_theme|default('amber')|e('js') }}'.toLowerCase();
        var defaultMode = '{{ default_mode|default('light')|e('js') }}'.toLowerCase();
        var theme = (root.getAttribute('data-theme') || defaultTheme || 'amber').toLowerCase();
        var mode = (root.getAttribute('data-mode') || defaultMode || 'light').toLowerCase();
        var pageBackgroundByMode = {
          light: '#f8fafc',
          dark: '#101216'
        };
        var glowByMode = {
          light: {
            amber: '#fef3c7',
            blue: '#dbeafe',
            green: '#dcfce7',
            red: '#fee2e2',
            violet: '#ede9fe'
          },
          dark: {
            amber: '#322114',
            blue: '#111a2c',
            green: '#10271c',
            red: '#2f1114',
            violet: '#22153a'
          }
        };
        var resolvedMode = Object.prototype.hasOwnProperty.call(pageBackgroundByMode, mode) ? mode : 'light';
        var pageBackground = pageBackgroundByMode[resolvedMode];
        var glowPalette = glowByMode[resolvedMode] || glowByMode.light;
        var glowBackground = glowPalette[theme] || glowPalette[defaultTheme] || glowPalette.amber;
        var criticalPaint = document.getElementById('nc-dashboard-critical-paint');

        if (!criticalPaint) {
          criticalPaint = document.createElement('style');
          criticalPaint.id = 'nc-dashboard-critical-paint';
          document.head.appendChild(criticalPaint);
        }

        criticalPaint.textContent =
          'html,body{margin:0;min-height:100%;background-color:' + pageBackground + ';}' +
          'html{color-scheme:' + (resolvedMode === 'dark' ? 'dark' : 'light') + ';}' +
          'body{background-image:radial-gradient(circle at top right,' + glowBackground + ',' + pageBackground + ' 50%);background-repeat:no-repeat;}';

        root.style.backgroundColor = pageBackground;
      } catch (error) {
      }
    })();
  </script>
  <script>
    (function () {
      try {
        var root = document.documentElement;
        var isDesktop = window.matchMedia && window.matchMedia('(min-width: 981px)').matches;
        var savedSidebarCollapsed = localStorage.getItem('natalcode_dashboard_sidebar_collapsed') === '1';

        if (isDesktop && savedSidebarCollapsed) {
          root.setAttribute('data-dashboard-sidebar-collapsed', '1');
        } else {
          root.removeAttribute('data-dashboard-sidebar-collapsed');
        }
      } catch (error) {
      }
    })();
  </script>
  {% set google_fonts_href = 'https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Lora:wght@500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="{{ google_fonts_href }}" as="style">
  <link rel="stylesheet" href="{{ google_fonts_href }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ google_fonts_href }}"></noscript>
  {% set asset_version = app_asset_version|default('1') %}
  {% set favicon_version = app_favicon_version|default(asset_version ~ '-cede-apple180') %}
  <link rel="stylesheet" href="/assets/css/cedern.css?v={{ asset_version }}">
  <link rel="icon" type="image/png" sizes="180x180" href="{{ base_url ?? '' }}/assets/img/brands/cede4_apple_touch_180.png?v={{ favicon_version }}">
  <link rel="shortcut icon" href="{{ base_url ?? '' }}/favicon.ico?v={{ favicon_version }}" type="image/x-icon">
  <link rel="icon" type="image/x-icon" href="{{ base_url ?? '' }}/favicon.ico?v={{ favicon_version }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ base_url ?? '' }}/assets/img/brands/cede4_favicon_32.png?v={{ favicon_version }}">
  <link rel="icon" type="image/png" sizes="192x192" href="{{ base_url ?? '' }}/assets/img/brands/cede4_favicon_192.png?v={{ favicon_version }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ base_url ?? '' }}/assets/img/brands/cede4_apple_touch_180.png?v={{ favicon_version }}">
  <script src="/assets/js/cedern-theme.js?v={{ asset_version }}" defer></script>
  {% block head %}{% endblock %}
</head>
<body data-default-theme="{{ default_theme|default('amber') }}" data-default-mode="{{ default_mode|default('light') }}" data-default-dark-intensity="{{ default_dark_intensity|default('neutral') }}" data-theme-palette="{{ app_dashboard_theme_palette_enabled|default(true) ? 'enabled' : 'disabled' }}">
  {% block content %}{% endblock %}
  {% include 'components/theme-palette.twig' with { theme_palette_enabled: app_dashboard_theme_palette_enabled|default(true) } %}
</body>
</html>
