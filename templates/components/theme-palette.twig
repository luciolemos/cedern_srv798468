{% set theme_palette_enabled = theme_palette_enabled|default(false) %}
{% set theme_options = app_theme_options|default([]) %}
{% set mode_options = app_mode_options|default([]) %}
{% set dark_intensity_options = app_dark_intensity_options|default([]) %}
{% set allowed_modes = app_theme_allowed_modes|default([]) %}
{% set has_mode_controls = theme_palette_enabled and mode_options|length > 1 %}
{% set has_dark_intensity_controls = theme_palette_enabled and ('dark' in allowed_modes) and dark_intensity_options|length > 1 %}
{% set has_theme_controls = theme_palette_enabled and theme_options|length > 1 %}
{% set has_palette_controls = has_mode_controls or has_dark_intensity_controls or has_theme_controls %}
<aside
  class="nc-utility-stack"
  data-utility-stack
  data-scroll-threshold-mobile="110"
  data-scroll-threshold-desktop="260"
  aria-label="Ferramentas de interface"
>
  <button type="button" class="nc-scroll-top" data-scroll-top aria-label="Voltar ao topo" hidden>
    ↑
  </button>

  {% if has_palette_controls %}
  <section class="nc-palette" aria-label="Paleta de cores do site">
    <button type="button" class="nc-palette-toggle" data-palette-toggle aria-expanded="false" aria-controls="nc-palette-panel">
      <span class="nc-palette-toggle-label-full">Personalizar cores</span>
      <span class="nc-palette-toggle-label-mobile">Cores</span>
    </button>

    <div class="nc-palette-panel" id="nc-palette-panel" data-palette-panel hidden>
      {% if has_mode_controls %}
      <p class="nc-palette-title">Modo</p>
      <div class="nc-mode-group" role="group" aria-label="Alternar modo claro e escuro">
        {% for mode_option in mode_options %}
          <button type="button" class="nc-mode-btn" data-mode-value="{{ mode_option.value }}" aria-pressed="false" aria-label="{{ mode_option.aria_label }}">
            {{ mode_option.label }}
          </button>
        {% endfor %}
      </div>
      {% endif %}

      {% if has_dark_intensity_controls %}
      <div class="nc-intensity-wrap" data-dark-intensity-wrap hidden>
        <p class="nc-palette-title">Intensidade (modo escuro)</p>
        <div class="nc-mode-group" role="group" aria-label="Alternar intensidade do modo escuro">
          {% for intensity_option in dark_intensity_options %}
            <button type="button" class="nc-mode-btn" data-dark-intensity-value="{{ intensity_option.value }}" aria-pressed="false" aria-label="{{ intensity_option.aria_label }}">
              {{ intensity_option.label }}
            </button>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if has_theme_controls %}
      <p class="nc-palette-title">Paleta de cores</p>
      <div class="nc-palette-grid">
        {% for theme_option in theme_options %}
          <button type="button" class="nc-swatch" data-theme-value="{{ theme_option.value }}" aria-pressed="false" aria-label="{{ theme_option.aria_label }}">
            <span class="nc-swatch-dot {{ theme_option.swatch_dot_class|default('') }}"></span>
            <span class="nc-swatch-label">{{ theme_option.label }}</span>
          </button>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}
</aside>
