{% extends 'layouts/base.twig' %}

{% block head %}
  <script src="{{ base_url ?? '' }}/assets/js/cedern-member-profile.js?v={{ app_asset_version|default('1') }}" defer></script>
{% endblock %}

{% block content %}
  <main class="nc-main nc-home-flow">
    <section class="nc-section" aria-label="Completar perfil do membro" data-aos="fade-up" data-aos-delay="0">
      <div class="nc-container">
        {% set member_profile_requires_contribution = member_profile_requires_contribution|default(false) %}
        {% set member_profile_is_contributor = member_profile_is_contributor|default(false) %}
        {% set member_profile_association_status_label = member_profile_association_status_label|default('Solicitante') %}
        <div class="nc-member-profile-header">
          {% include 'components/section-header.twig' with {
            kicker: 'Área do Membro',
            title: 'Complete seu perfil',
            lead: 'Finalize seu cadastro com os dados obrigatórios para liberar sua área de membro com segurança.'
          } %}
        </div>

        <div class="nc-member-profile-notice" role="note" aria-label="Orientações sobre dados do perfil">
          <strong>Dados necessários para ativar sua área do membro</strong>
          <p>Usamos essas informações para identificar seu cadastro, manter contato com você, proteger o acesso à área restrita do CEDE e, quando aplicável, organizar a contribuição mensal.</p>
          <ul class="nc-member-profile-notice-list">
            <li><span>Obrigatórios:</span> foto de perfil, celular, data de nascimento, CPF e endereço.</li>
            {% if member_profile_requires_contribution %}
              <li><span>Contribuição:</span> seu cadastro está como associado contribuinte. Dia de vencimento, forma de pagamento e valor ou plano ficam obrigatórios nesta etapa.</li>
            {% else %}
              <li><span>Contribuição:</span> seu vínculo atual é {{ member_profile_association_status_label|lower }}{% if not member_profile_is_contributor %} sem participação financeira{% endif %}. Os campos financeiros abaixo podem ser preenchidos depois, se necessário.</li>
            {% endif %}
            <li><span>Opcional:</span> telefone fixo, complemento do endereço e autorizações de lembrete.</li>
            <li class="nc-member-profile-notice-line"><span>Transparência:</span> o tratamento segue a <a class="nc-link" href="{{ base_url ?? '' }}/politica-de-privacidade">Política de Privacidade</a> do CEDE.</li>
          </ul>
        </div>

        <article class="nc-card nc-admin-login-card nc-member-profile-card">
          {% if member_profile_errors %}
            <div class="nc-admin-login-error" role="alert">
              <ul>
                {% for error in member_profile_errors %}
                  <li>{{ error }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {% if member_profile_warnings %}
            <div class="nc-admin-login-success" role="status">
              <ul>
                {% for warning in member_profile_warnings %}
                  <li>{{ warning }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <form class="nc-admin-login-form nc-member-profile-form" method="post" action="{{ base_url ?? '' }}/membro/perfil/completar" enctype="multipart/form-data">
            {% include 'components/csrf-field.twig' %}
            <input type="hidden" name="redirect_to" value="{{ member_profile_redirect_to|default('/membro') }}">

            <div class="nc-member-profile-sections">
              <section class="nc-member-profile-group" aria-labelledby="member-profile-personal-title">
                <div class="nc-member-profile-group-header">
                  <h3 id="member-profile-personal-title">Dados pessoais</h3>
                  <p class="nc-member-subtitle">Identificação principal, documento e formas de contato da pessoa cadastrada.</p>
                </div>

                <div class="nc-member-profile-group-grid">
                  <div class="nc-member-photo-field nc-member-profile-field-full">
                    <p class="nc-admin-login-label">Foto de perfil <span class="nc-member-profile-tag is-required">Obrigatório</span></p>
                    <div class="nc-member-photo-preview-wrap">
                      {% set member_profile_photo_path = member_profile_form.profile_photo_path|default('')|trim %}
                      {% if member_profile_photo_path %}
                        <img class="nc-member-photo-preview" src="{{ (base_url ?? '') ~ '/' ~ (member_profile_photo_path|trim('/')) }}" alt="Foto atual do perfil">
                      {% else %}
                        <div class="nc-member-photo-placeholder" aria-hidden="true">Sem foto</div>
                      {% endif %}
                    </div>
                    <input class="nc-admin-login-input" id="profile_photo" name="profile_photo" type="file" accept="image/png,image/jpeg,image/webp"{% if not member_profile_form.profile_photo_path %} required{% endif %}>
                    <small class="nc-member-profile-help">Formatos aceitos: JPG, PNG ou WEBP (máx. 2MB). A foto é necessária para concluir o cadastro.</small>
                  </div>

                  <div class="nc-admin-login-field nc-member-profile-field-name">
                    <label class="nc-admin-login-label" for="full_name">Nome completo</label>
                    <input class="nc-admin-login-input" id="full_name" name="full_name" type="text" value="{{ member_profile_form.full_name|default('') }}" autocomplete="name" required>
                  </div>

                  <div class="nc-admin-login-field nc-member-profile-field-birth-date">
                    <label class="nc-admin-login-label" for="birth_date">Data de nascimento <span class="nc-member-profile-tag is-required">Obrigatório</span></label>
                    <input class="nc-admin-login-input" id="birth_date" name="birth_date" type="date" value="{{ member_profile_form.birth_date|default('') }}" required>
                  </div>

                  <div class="nc-admin-login-field">
                    <label class="nc-admin-login-label" for="cpf">CPF <span class="nc-member-profile-tag is-required">Obrigatório</span></label>
                    <input class="nc-admin-login-input" id="cpf" name="cpf" type="text" value="{{ member_profile_form.cpf|default('') }}" inputmode="numeric" maxlength="14" placeholder="000.000.000-00" required>
                  </div>

                  <div class="nc-admin-login-field nc-member-profile-field-email">
                    <label class="nc-admin-login-label" for="email">E-mail cadastrado</label>
                    <input class="nc-admin-login-input" id="email" type="email" value="{{ member_profile_form.email|default('') }}" autocomplete="email" readonly aria-readonly="true">
                    <small class="nc-member-profile-help">O e-mail de acesso é exibido aqui apenas para conferência.</small>
                  </div>

                  <div class="nc-admin-login-field">
                    <label class="nc-admin-login-label" for="phone_mobile">Celular <span class="nc-member-profile-tag is-required">Obrigatório</span></label>
                    <input class="nc-admin-login-input" id="phone_mobile" name="phone_mobile" type="text" value="{{ member_profile_form.phone_mobile|default('') }}" autocomplete="tel" inputmode="numeric" maxlength="15" placeholder="(84) 99999-9999" required>
                  </div>

                  <div class="nc-admin-login-field">
                    <label class="nc-admin-login-label" for="phone_landline">Telefone fixo <span class="nc-member-profile-tag is-optional">Opcional</span></label>
                    <input class="nc-admin-login-input" id="phone_landline" name="phone_landline" type="text" value="{{ member_profile_form.phone_landline|default('') }}" autocomplete="tel-national" inputmode="numeric" maxlength="14" placeholder="(84) 3210-1234">
                  </div>

                  <div class="nc-admin-login-field">
                    <label class="nc-admin-login-label" for="birth_state">UF de nascimento</label>
                    <select class="nc-admin-login-input" id="birth_state" name="birth_state" data-member-birth-state required>
                      <option value="">Selecione a UF</option>
                      {% for state_code, state_label in member_profile_state_options|default({}) %}
                        <option value="{{ state_code }}"{% if member_profile_form.birth_state|default('') == state_code %} selected{% endif %}>{{ state_label }}</option>
                      {% endfor %}
                    </select>
                  </div>

                  <div class="nc-admin-login-field">
                    <label class="nc-admin-login-label" for="birth_city">Cidade de nascimento</label>
                    <select class="nc-admin-login-input" id="birth_city" name="birth_city" data-member-birth-city data-selected-city="{{ member_profile_form.birth_city|default('')|e('html_attr') }}" required>
                      <option value="">Selecione a cidade</option>
                    </select>
                    <input type="hidden" name="birth_place" value="{{ member_profile_form.birth_place|default('') }}">
                  </div>
                </div>
              </section>

              <section class="nc-member-profile-group" aria-labelledby="member-profile-address-title">
                <div class="nc-member-profile-group-header">
                  <h3 id="member-profile-address-title">Endereço</h3>
                  <p class="nc-member-subtitle">Dados residenciais usados para conferência cadastral e para emissão de cobranças quando necessário.</p>
                </div>

                <div class="nc-member-profile-group-grid">
                  <div class="nc-member-profile-address-row nc-member-profile-field-full">
                    <div class="nc-admin-login-field">
                      <label class="nc-admin-login-label" for="postal_code">CEP <span class="nc-member-profile-tag is-required">Obrigatório</span></label>
                      <input class="nc-admin-login-input" id="postal_code" name="postal_code" type="text" value="{{ member_profile_form.postal_code|default('') }}" inputmode="numeric" maxlength="9" placeholder="00000-000" required>
                    </div>

                    <div class="nc-admin-login-field">
                      <label class="nc-admin-login-label" for="street_address">Logradouro <span class="nc-member-profile-tag is-required">Obrigatório</span></label>
                      <input class="nc-admin-login-input" id="street_address" name="street_address" type="text" value="{{ member_profile_form.street_address|default('') }}" autocomplete="address-line1" placeholder="Rua, avenida, travessa..." required>
                    </div>

                    <div class="nc-admin-login-field">
                      <label class="nc-admin-login-label" for="address_number">Número <span class="nc-member-profile-tag is-required">Obrigatório</span></label>
                      <input class="nc-admin-login-input" id="address_number" name="address_number" type="text" value="{{ member_profile_form.address_number|default('') }}" autocomplete="address-line2" placeholder="Ex: 123" required>
                    </div>
                  </div>

                  <div class="nc-admin-login-field nc-member-profile-field-full">
                    <label class="nc-admin-login-label" for="address_complement">Complemento <span class="nc-member-profile-tag is-optional">Opcional</span></label>
                    <input class="nc-admin-login-input" id="address_complement" name="address_complement" type="text" value="{{ member_profile_form.address_complement|default('') }}" placeholder="Apto, bloco, referência...">
                  </div>

                  <div class="nc-member-profile-address-locality-row nc-member-profile-field-full">
                    <div class="nc-admin-login-field">
                      <label class="nc-admin-login-label" for="neighborhood">Bairro <span class="nc-member-profile-tag is-required">Obrigatório</span></label>
                      <input class="nc-admin-login-input" id="neighborhood" name="neighborhood" type="text" value="{{ member_profile_form.neighborhood|default('') }}" autocomplete="address-level3" required>
                    </div>

                    <div class="nc-admin-login-field">
                      <label class="nc-admin-login-label" for="address_state">UF <span class="nc-member-profile-tag is-required">Obrigatório</span></label>
                      <select class="nc-admin-login-input" id="address_state" name="address_state" data-member-address-state autocomplete="address-level1" required>
                        <option value="">Selecione a UF</option>
                        {% for state_code, state_label in member_profile_state_options|default({}) %}
                          <option value="{{ state_code }}"{% if member_profile_form.address_state|default('') == state_code %} selected{% endif %}>{{ state_label }}</option>
                        {% endfor %}
                      </select>
                    </div>

                    <div class="nc-admin-login-field">
                      <label class="nc-admin-login-label" for="address_city">Cidade <span class="nc-member-profile-tag is-required">Obrigatório</span></label>
                      <select class="nc-admin-login-input" id="address_city" name="address_city" data-member-address-city data-selected-city="{{ member_profile_form.address_city|default('')|e('html_attr') }}" autocomplete="address-level2" required>
                        <option value="">Selecione a cidade</option>
                      </select>
                    </div>
                  </div>
                </div>
              </section>

              <section class="nc-member-profile-group" aria-labelledby="member-profile-finance-title">
                <div class="nc-member-profile-group-header">
                  <h3 id="member-profile-finance-title">Contribuição e cobrança</h3>
                  <p class="nc-member-subtitle">
                    {% if member_profile_requires_contribution %}
                      Aqui ficam o vencimento, o valor e a forma preferida para organizar cobranças e lembretes do associado contribuinte.
                    {% else %}
                      Estes dados só são necessários quando a administração marcar seu cadastro como contribuinte. Você pode deixá-los em branco por enquanto.
                    {% endif %}
                  </p>
                </div>

                <div class="nc-member-profile-group-grid">
                  <div class="nc-member-profile-contribution-row nc-member-profile-field-full">
                    <div class="nc-admin-login-field">
                      <label class="nc-admin-login-label" for="preferred_due_day">
                        VENCIMENTO
                        <span class="nc-member-profile-tag {{ member_profile_requires_contribution ? 'is-required' : 'is-optional' }}">{{ member_profile_requires_contribution ? 'Obrigatório' : 'Opcional' }}</span>
                      </label>
                      <select class="nc-admin-login-input" id="preferred_due_day" name="preferred_due_day"{% if member_profile_requires_contribution %} required{% endif %}>
                        <option value="">Selecione o dia</option>
                        {% for day in 1..28 %}
                          {% set day_value = day ~ '' %}
                          <option value="{{ day_value }}"{% if member_profile_form.preferred_due_day|default('') == day_value %} selected{% endif %}>Dia {{ '%02d'|format(day) }}</option>
                        {% endfor %}
                      </select>
                      <small class="nc-member-profile-help">Limitamos até o dia 28 para evitar inconsistências em meses menores.</small>
                    </div>

                    <div class="nc-admin-login-field">
                      <label class="nc-admin-login-label" for="contribution_amount">
                        Valor da contribuição
                        <span class="nc-member-profile-tag {{ member_profile_requires_contribution ? 'is-required' : 'is-optional' }}">{{ member_profile_requires_contribution ? 'Obrigatório ou plano' : 'Opcional' }}</span>
                      </label>
                      <input class="nc-admin-login-input" id="contribution_amount" name="contribution_amount" type="text" value="{{ member_profile_form.contribution_amount|default('') }}" inputmode="decimal" placeholder="Ex: 50,00">
                      <small class="nc-member-profile-help">
                        {% if member_profile_requires_contribution %}
                          O valor da cobrança mensal é definido aqui. "Plano definido pela diretoria" pode complementar o enquadramento administrativo.
                        {% else %}
                          Preencha apenas se a diretoria já tiver definido sua participação financeira.
                        {% endif %}
                      </small>
                    </div>

                    <div class="nc-admin-login-field">
                      <label class="nc-admin-login-label" for="preferred_payment_method">
                        Forma preferida
                        <span class="nc-member-profile-tag {{ member_profile_requires_contribution ? 'is-required' : 'is-optional' }}">{{ member_profile_requires_contribution ? 'Obrigatório' : 'Opcional' }}</span>
                      </label>
                      <select class="nc-admin-login-input" id="preferred_payment_method" name="preferred_payment_method"{% if member_profile_requires_contribution %} required{% endif %}>
                        <option value="">Selecione a forma</option>
                        {% for payment_value, payment_label in member_profile_payment_method_options|default({}) %}
                          <option value="{{ payment_value }}"{% if member_profile_form.preferred_payment_method|default('') == payment_value %} selected{% endif %}>{{ payment_label }}</option>
                        {% endfor %}
                      </select>
                    </div>
                  </div>

                  <div class="nc-admin-login-field nc-member-profile-field-full">
                    <label class="nc-admin-login-label" for="contribution_plan_label">
                      Plano definido pela diretoria
                      <span class="nc-member-profile-tag {{ member_profile_requires_contribution ? 'is-required' : 'is-optional' }}">{{ member_profile_requires_contribution ? 'Pode substituir o valor' : 'Opcional' }}</span>
                    </label>
                    <input class="nc-admin-login-input" id="contribution_plan_label" name="contribution_plan_label" type="text" value="{{ member_profile_form.contribution_plan_label|default('') }}" placeholder="Ex: Plano associado efetivo 2026">
                  </div>
                </div>
              </section>

              <section class="nc-member-profile-group" aria-labelledby="member-profile-consents-title">
                <div class="nc-member-profile-group-header">
                  <h3 id="member-profile-consents-title">Autorizações</h3>
                  <p class="nc-member-subtitle">Defina como o CEDE pode encaminhar cobranças, lembretes e registrar a ciência do aviso de privacidade.</p>
                </div>

                <div class="nc-member-profile-group-grid nc-member-profile-group-grid-single">
                  <div class="nc-admin-login-field nc-member-profile-field-full">
                    <label class="nc-member-profile-consent" for="billing_email_opt_in">
                      <input id="billing_email_opt_in" name="billing_email_opt_in" type="checkbox" value="1"{% if member_profile_form.billing_email_opt_in|default('') == '1' %} checked{% endif %}>
                      <span>Autorizo o CEDE a enviar cobranças e segunda via por e-mail.</span>
                    </label>
                  </div>

                  <div class="nc-admin-login-field nc-member-profile-field-full">
                    <label class="nc-member-profile-consent" for="billing_whatsapp_opt_in">
                      <input id="billing_whatsapp_opt_in" name="billing_whatsapp_opt_in" type="checkbox" value="1"{% if member_profile_form.billing_whatsapp_opt_in|default('') == '1' %} checked{% endif %}>
                      <span>Autorizo o CEDE a enviar lembretes de contribuição por WhatsApp.</span>
                    </label>
                  </div>

                  <div class="nc-admin-login-field nc-member-profile-field-full">
                    {% if member_profile_privacy_notice_required %}
                      <label class="nc-member-profile-consent" for="privacy_notice_acknowledged">
                        <input id="privacy_notice_acknowledged" name="privacy_notice_acknowledged" type="checkbox" value="1"{% if member_profile_form.privacy_notice_acknowledged|default('') == '1' %} checked{% endif %} required>
                        <span>Declaro ciência do aviso acima e da <a class="nc-link" href="{{ base_url ?? '' }}/politica-de-privacidade" target="_blank" rel="noopener">Política de Privacidade</a> do CEDE para tratamento dos meus dados nesta etapa de ativação da área do membro.</span>
                      </label>
                      <small class="nc-member-profile-help">Ao salvar, o sistema registrará a ciência deste aviso para a versão {{ member_profile_privacy_notice_version }}.</small>
                    {% elseif member_profile_privacy_notice_acknowledged_at %}
                      <div class="nc-member-profile-consent-status" role="status">
                        Ciência do aviso de privacidade já registrada anteriormente para este cadastro.
                      </div>
                    {% endif %}
                  </div>
                </div>
              </section>

              <div class="nc-actions nc-admin-login-actions nc-member-profile-actions is-stacked-mobile" data-aos="fade-up" data-aos-delay="80">
                <button class="nc-btn nc-btn-primary nc-admin-login-submit" type="submit">Salvar e continuar</button>
                <button
                  class="nc-btn nc-btn-secondary"
                  type="submit"
                  formaction="{{ base_url ?? '' }}/membro/perfil/completar/pdf"
                  formtarget="_blank"
                  formnovalidate
                >
                  Gerar PDF do cadastro
                </button>
                <a class="nc-btn nc-btn-secondary" href="{{ base_url ?? '' }}/membro/sair">Sair e continuar depois</a>
              </div>
            </div>
          </form>
        </article>
      </div>
    </section>
  </main>
{% endblock %}
