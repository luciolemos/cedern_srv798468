{% extends 'layouts/admin-dashboard.twig' %}

{% set dashboard_page_kicker = 'Dashboard' %}
{% set dashboard_page_title = 'Registrar manutenção' %}
{% set dashboard_page_lead = 'Associe serviços, custos e próximos vencimentos ao histórico do bem patrimonial.' %}
{% set patrimony_base_url = base_url ?? '' %}

{% block admin_content %}
  <section class="nc-section" aria-label="Registrar manutenção patrimonial" data-aos="fade-up" data-aos-delay="0">
    {% if patrimony_maintenance_form_errors|length > 0 %}
      <article class="nc-admin-form-errors" role="alert">
        <strong>Corrija os campos abaixo:</strong>
        <ul>
          {% for error in patrimony_maintenance_form_errors %}
            <li>{{ error }}</li>
          {% endfor %}
        </ul>
      </article>
    {% endif %}

    <div class="nc-actions nc-admin-toolbar" data-aos="fade-up" data-aos-delay="60">
      <a class="nc-btn nc-btn-secondary nc-btn-back" href="{{ patrimony_base_url }}/painel">Voltar ao painel</a>
      <a class="nc-btn nc-btn-secondary nc-btn-back" href="{{ patrimony_base_url }}/painel/patrimonio/{{ patrimony_asset.id }}/editar">Voltar ao patrimônio</a>
    </div>

    <article class="nc-card nc-admin-form-card">
      <p><strong>{{ patrimony_asset.asset_code }}</strong> · {{ patrimony_asset.name }}</p>

      <form class="nc-admin-form" method="post" enctype="multipart/form-data" action="{{ patrimony_base_url }}/painel/patrimonio/{{ patrimony_asset.id }}/manutencoes/nova">
        {% include 'components/csrf-field.twig' %}
        <div class="nc-admin-form-grid nc-admin-form-grid-identity">
          <div class="nc-admin-form-field">
            <label class="nc-admin-form-label" for="maintenance_date">Data da manutenção</label>
            <input class="nc-admin-form-input" id="maintenance_date" name="maintenance_date" type="datetime-local" value="{{ patrimony_maintenance_form.maintenance_date|default('') }}" required>
          </div>

          <div class="nc-admin-form-field">
            <label class="nc-admin-form-label" for="maintenance_type">Tipo da manutenção</label>
            <input class="nc-admin-form-input" id="maintenance_type" name="maintenance_type" type="text" value="{{ patrimony_maintenance_form.maintenance_type|default('') }}" placeholder="Preventiva, corretiva..." required>
          </div>

          <div class="nc-admin-form-field">
            <label class="nc-admin-form-label" for="vendor_name">Empresa responsável</label>
            <input class="nc-admin-form-input" id="vendor_name" name="vendor_name" type="text" value="{{ patrimony_maintenance_form.vendor_name|default('') }}">
          </div>

          <div class="nc-admin-form-field">
            <label class="nc-admin-form-label" for="cost_amount">Valor gasto</label>
            <input class="nc-admin-form-input" id="cost_amount" name="cost_amount" type="text" value="{{ patrimony_maintenance_form.cost_amount|default('') }}" placeholder="Ex: 350,00">
          </div>

          <div class="nc-admin-form-field">
            <label class="nc-admin-form-label" for="next_maintenance_at">Próxima manutenção</label>
            <input class="nc-admin-form-input" id="next_maintenance_at" name="next_maintenance_at" type="date" value="{{ patrimony_maintenance_form.next_maintenance_at|default('') }}">
          </div>

          <div class="nc-admin-form-field">
            <label class="nc-admin-form-label" for="current_status">Situação do bem após o registro</label>
            <select class="nc-admin-form-input" id="current_status" name="current_status" required>
              {% for key, label in patrimony_status_options %}
                <option value="{{ key }}"{% if patrimony_maintenance_form.current_status|default('em_manutencao') == key %} selected{% endif %}>{{ label }}</option>
              {% endfor %}
            </select>
          </div>

          <div class="nc-admin-form-field">
            <label class="nc-admin-form-label" for="attachment_file">Anexo</label>
            <input class="nc-admin-form-input" id="attachment_file" name="attachment_file" type="file" accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx,.xls,.xlsx">
          </div>
        </div>

        <div class="nc-admin-form-field nc-admin-form-field-full">
          <label class="nc-admin-form-label" for="service_description">Descrição do serviço</label>
          <textarea class="nc-admin-form-input" id="service_description" name="service_description" rows="4" required>{{ patrimony_maintenance_form.service_description|default('') }}</textarea>
        </div>

        <div class="nc-admin-form-field nc-admin-form-field-full">
          <label class="nc-admin-form-label" for="notes">Observações</label>
          <textarea class="nc-admin-form-input" id="notes" name="notes" rows="4">{{ patrimony_maintenance_form.notes|default('') }}</textarea>
        </div>

        <div class="nc-actions nc-admin-form-actions">
          <button class="nc-btn nc-btn-primary nc-admin-action-create" type="submit">Registrar manutenção</button>
          <a class="nc-btn nc-btn-secondary nc-btn-back" href="{{ patrimony_base_url }}/painel/patrimonio/{{ patrimony_asset.id }}/editar">Cancelar</a>
        </div>
      </form>
    </article>
  </section>
{% endblock %}
