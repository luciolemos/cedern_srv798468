{% extends 'layouts/base.twig' %}

{% block content %}
  <main class="nc-main nc-home-flow">
    <section class="nc-section" aria-label="Área do membro" data-aos="fade-up" data-aos-delay="0">
      <div class="nc-container">
        {% set member_role_summary = member_role_display_name|default(member_data.role_name|default(member_role_name|default('Membro'))) %}
        {% set member_association_summary = member_data.association_status_label|default('Associado') %}
        {% set member_type_summary = member_data.member_type_label|default(member_data.member_type|default('Não definido')) %}
        {% set member_contribution_summary = member_data.contributor_label|default('Não') %}
        {% set member_contribution_summary_normalized = member_contribution_summary|lower|replace({'ã': 'a'}) %}
        {% set member_contribution_display = member_contribution_summary_normalized == 'sim' ? 'Ativa' : (member_contribution_summary_normalized == 'nao' ? 'Não ativa' : member_contribution_summary) %}
        {% set member_institutional_role_summary = member_data.institutional_role|default('Sem função definida') %}
        {% set member_due_day_summary = member_data.preferred_due_day_display|default('Não definido') %}
        {% set member_contribution_amount_summary = member_data.contribution_amount_display|default('Não definido') %}
        {% set member_payment_method_summary = member_data.preferred_payment_method_display|default('Não definido') %}
        {% set member_contribution_status_note = member_contribution_summary_normalized == 'sim'
          ? 'Sua contribuição já está configurada no cadastro e pode ser acompanhada por aqui.'
          : 'No momento, não existe uma contribuição ativa vinculada ao seu cadastro.' %}

        <div class="nc-member-home-header">
          {% include 'components/section-header.twig' with {
            kicker: 'Área do Membro',
            title: 'Bem-vindo, ' ~ (member_data.full_name|default(member_name|default('Membro'))),
            lead: 'Sua área pessoal está ativa. Veja abaixo um resumo rápido do seu cadastro e os próximos passos na área do membro.'
          } %}
        </div>

        {% if member_home_status == 'forbidden' %}
          <p class="nc-admin-login-error" role="alert">Seu perfil não possui permissão para acessar a área solicitada.</p>
        {% elseif member_home_status == 'profile-updated' %}
          <p class="nc-admin-login-success" role="status">Perfil atualizado com sucesso.</p>
        {% elseif member_home_status == 'profile-updated-no-photo' %}
          <p class="nc-admin-login-success" role="status">Perfil atualizado, mas não foi possível salvar a foto agora. Tente novamente em instantes.</p>
        {% elseif member_home_status == 'interest-added' %}
          <p class="nc-admin-login-success" role="status">Evento salvo no seu calendário pessoal.</p>
        {% elseif member_home_status == 'interest-removed' %}
          <p class="nc-admin-login-success" role="status">Evento removido do seu calendário pessoal.</p>
        {% elseif member_home_status == 'interest-error' %}
          <p class="nc-admin-login-error" role="alert">Não foi possível atualizar seu calendário agora. Tente novamente.</p>
        {% endif %}

        <article class="nc-card nc-member-panel nc-member-account-card" aria-label="Minha conta" data-aos="fade-up" data-aos-delay="100">
          <div class="nc-member-account-top">
            {% set member_data_photo_path = member_data.profile_photo_path|default('')|trim %}
            <div class="nc-member-account-intro">
              <div class="nc-member-header">
                <div class="nc-member-avatar-wrap" aria-hidden="true">
                  {% if member_data_photo_path %}
                    <img class="nc-member-avatar" src="{{ member_profile_photo_url(member_data_photo_path, base_url ?? '') }}" alt="">
                  {% else %}
                    <div class="nc-member-avatar-placeholder">{{ (member_data.full_name|default('M')|slice(0, 1)|upper) }}</div>
                  {% endif %}
                </div>
                <div class="nc-member-header-text">
                  <p class="nc-member-overview-kicker">Minha conta</p>
                  <h3>{{ member_data.full_name|default(member_name|default('Membro')) }}</h3>
                  <p>Seu status de acesso, sua contribuição e seus dados essenciais ficam centralizados aqui.</p>
                </div>
              </div>
            </div>

            <div class="nc-actions nc-admin-login-actions nc-member-actions nc-member-account-actions is-stacked-mobile" data-aos="fade-up" data-aos-delay="80">
              <a class="nc-btn nc-btn-secondary" href="/membro/perfil/completar">Editar dados do perfil</a>
              <a class="nc-btn nc-btn-secondary" href="/">Voltar ao site</a>
              <form method="post" action="/membro/sair" onsubmit="return confirm('Deseja realmente encerrar sua sessão?');">
                {% include 'components/csrf-field.twig' %}
                <button class="nc-btn nc-admin-action-delete" type="submit">Encerrar sessão</button>
              </form>
            </div>
          </div>

          <div class="nc-member-profile-sections nc-member-account-sections">
            <section class="nc-member-profile-group" aria-label="Situação atual da conta">
              <div class="nc-member-profile-group-header">
                <h3>Situação da conta</h3>
                <p class="nc-member-subtitle">Os dados institucionais que definem como seu acesso está configurado hoje no CEDE.</p>
              </div>

              <dl class="nc-member-grid nc-member-account-status-grid">
                <div>
                  <dt>Perfil de acesso</dt>
                  <dd>{{ member_role_summary }}</dd>
                </div>
                <div>
                  <dt>Vínculo atual</dt>
                  <dd>{{ member_association_summary }}</dd>
                </div>
                <div>
                  <dt>Categoria de sócio</dt>
                  <dd>{{ member_type_summary }}</dd>
                </div>
                <div class="{{ member_institutional_role_summary == 'Sem função definida' ? 'is-muted' : '' }}">
                  <dt>Função no CEDE</dt>
                  <dd>{{ member_institutional_role_summary }}</dd>
                </div>
              </dl>
            </section>

            <section class="nc-member-profile-group" aria-label="Contribuição e cobrança">
              <div class="nc-member-profile-group-header">
                <h3>Contribuição e cobrança</h3>
                <p class="nc-member-subtitle">O mesmo conjunto que você encontra em completar perfil: situação da contribuição, vencimento, valor e forma preferida.</p>
              </div>

              <div class="nc-member-account-contribution-state {{ member_contribution_summary_normalized == 'sim' ? 'is-active' : 'is-muted' }}">
                <span class="nc-member-account-contribution-label">Contribuição</span>
                <strong>{{ member_contribution_display }}</strong>
                <p>{{ member_contribution_status_note }}</p>
              </div>

              <dl class="nc-member-grid nc-member-grid-finance-summary">
                <div class="{{ member_due_day_summary == 'Não definido' ? 'is-muted' : '' }}">
                  <dt>Vencimento</dt>
                  <dd>{{ member_due_day_summary }}</dd>
                </div>
                <div class="{{ member_contribution_amount_summary == 'Não definido' ? 'is-muted' : '' }}">
                  <dt>Valor da contribuição</dt>
                  <dd>{{ member_contribution_amount_summary }}</dd>
                </div>
                <div class="{{ member_payment_method_summary == 'Não definido' ? 'is-muted' : '' }}">
                  <dt>Forma de pagamento</dt>
                  <dd>{{ member_payment_method_summary }}</dd>
                </div>
              </dl>
            </section>

            <section class="nc-member-profile-group" aria-label="Histórico das contribuições">
              <div class="nc-member-profile-group-header">
                <h3>Histórico das contribuições</h3>
                <p class="nc-member-subtitle">As últimas mensalidades registradas no seu cadastro, com competência, vencimento, pagamento, valor e forma utilizada.</p>
              </div>

              {% set history_filters = member_contribution_history_filters|default({}) %}
              {% if history_filters.total_count|default(0) > 0 %}
                <form class="nc-member-contribution-history-filters" method="get" action="/membro">
                  <div class="nc-member-contribution-history-filter-grid">
                    <div>
                      <label class="nc-admin-login-label" for="member-history-year">Ano</label>
                      <select class="nc-admin-login-input" id="member-history-year" name="history_year">
                        <option value="">Todos os anos</option>
                        {% for option in history_filters.year_options|default([]) %}
                          <option value="{{ option.value }}"{% if option.selected %} selected{% endif %}>{{ option.label }}</option>
                        {% endfor %}
                      </select>
                    </div>

                    <div>
                      <label class="nc-admin-login-label" for="member-history-competence">Competência</label>
                      <select class="nc-admin-login-input" id="member-history-competence" name="history_competence">
                        <option value="">Todas as competências</option>
                        {% for option in history_filters.competence_options|default([]) %}
                          <option value="{{ option.value }}"{% if option.selected %} selected{% endif %}>{{ option.label }}</option>
                        {% endfor %}
                      </select>
                    </div>

                    <div>
                      <label class="nc-admin-login-label" for="member-history-sort">Ordenação</label>
                      <select class="nc-admin-login-input" id="member-history-sort" name="history_sort">
                        {% for option in history_filters.sort_options|default([]) %}
                          <option value="{{ option.value }}"{% if option.selected %} selected{% endif %}>{{ option.label }}</option>
                        {% endfor %}
                      </select>
                    </div>

                    <div class="nc-member-contribution-history-filter-actions">
                      <button class="nc-btn nc-btn-primary" type="submit">Aplicar</button>
                      {% if history_filters.has_active|default(false) %}
                        <a class="nc-btn nc-btn-secondary" href="/membro">Limpar</a>
                      {% endif %}
                    </div>
                  </div>

                  <p class="nc-member-contribution-history-results">
                    {% set history_result_count = history_filters.result_count|default(0) %}
                    {% set history_total_count = history_filters.total_count|default(0) %}
                    {% if history_result_count == 1 %}
                      Exibindo 1 contribuição{% if history_total_count > 1 %} de {{ history_total_count }} registradas{% endif %}
                    {% else %}
                      Exibindo {{ history_result_count }} contribuições{% if history_total_count > history_result_count %} de {{ history_total_count }} registradas{% endif %}
                    {% endif %}
                    {% if history_filters.has_active|default(false) %} com filtro ou ordenação aplicada{% endif %}.
                  </p>
                </form>
              {% endif %}

              {% if member_contribution_history|default([])|length > 0 %}
                <div class="nc-admin-table-wrap nc-member-contribution-history-table-wrap">
                  <table class="nc-admin-table nc-member-contribution-history-table">
                    <thead>
                      <tr>
                        <th scope="col">Competência</th>
                        <th scope="col">Observação</th>
                        <th scope="col">Situação</th>
                        <th scope="col">Vencimento</th>
                        <th scope="col">Pagamento</th>
                        <th scope="col">Valor</th>
                        <th scope="col">Forma</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for contribution in member_contribution_history %}
                        <tr class="is-{{ contribution.status_key|default('pending') }}">
                          <td data-label="Competência" class="nc-member-contribution-history-cell-competence">
                            <strong>{{ contribution.competence_label|default('-') }}</strong>
                          </td>
                          <td data-label="Observação" class="nc-member-contribution-history-cell-summary">
                            {{ contribution.status_summary|default('Sem detalhes adicionais.') }}
                          </td>
                          <td data-label="Situação" class="nc-member-contribution-history-cell-status">
                            <span class="nc-member-contribution-history-badge {{ contribution.status_tone|default('is-info') }}">{{ contribution.status_label|default('Não definido') }}</span>
                          </td>
                          <td data-label="Vencimento">
                            {{ contribution.due_date_label|default('-') }}
                          </td>
                          <td data-label="Pagamento">
                            {{ contribution.paid_at_label|default('-') }}
                          </td>
                          <td data-label="Valor">
                            {{ contribution.amount_due_label|default('Não definido') }}
                          </td>
                          <td data-label="{{ contribution.payment_method_context_label|default('Forma') }}">
                            {{ contribution.payment_method_label|default('Não definido') }}
                          </td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              {% else %}
                <p class="nc-member-empty">
                  {{ history_filters.total_count|default(0) > 0
                    ? 'Nenhuma contribuição encontrada para os filtros selecionados.'
                    : 'Ainda não existem contribuições registradas no seu histórico.' }}
                </p>
              {% endif %}
            </section>

            <section class="nc-member-profile-group" aria-label="Dados essenciais do cadastro">
              <div class="nc-member-profile-group-header">
                <h3>Dados essenciais</h3>
                <p class="nc-member-subtitle">As informações principais associadas ao seu cadastro de membro.</p>
              </div>

              <dl class="nc-member-grid nc-member-overview-details">
                <div><dt>E-mail</dt><dd>{{ member_data.email|default('-') }}</dd></div>
                <div><dt>Celular</dt><dd>{{ member_data.phone_mobile|default('-') }}</dd></div>
                <div><dt>Telefone</dt><dd>{{ member_data.phone_landline|default('-') }}</dd></div>
                <div><dt>Data de nascimento</dt><dd>{{ member_data.birth_date_display|default('-') }}</dd></div>
                <div><dt>Naturalidade</dt><dd>{{ member_data.birth_place|default('-') }}</dd></div>
              </dl>
            </section>
          </div>
        </article>

        <section class="nc-member-dashboard" aria-label="Resumo do perfil">
          <article class="nc-card nc-member-panel nc-member-primary-action">
            <h3>Ação principal</h3>
            <p class="nc-member-subtitle">Foque no próximo passo mais importante para avançar na sua jornada.</p>
            <div class="nc-member-primary-content">
              <strong>{{ member_primary_action.title|default('Revise seu painel') }}</strong>
              <p>{{ member_primary_action.description|default('Seu painel está pronto para uso.') }}</p>
              <a class="nc-btn nc-btn-secondary nc-btn-block-mobile" href="{{ member_primary_action.href|default('/membro') }}">
                {{ member_primary_action.button_label|default('Continuar') }}
              </a>
            </div>
          </article>

          <article class="nc-card nc-member-panel">
            <h3>Notificações do membro</h3>
            <p class="nc-member-subtitle">Avisos relevantes para você agir com rapidez no que importa.</p>
            <ul class="nc-member-notification-list" aria-live="polite">
              {% for notification in member_notifications|default([]) %}
                <li class="is-{{ notification.type|default('info') }}">
                  <div>
                    <strong>{{ notification.title }}</strong>
                    <p>{{ notification.description }}</p>
                  </div>
                  <a class="nc-link" href="{{ notification.href|default('/membro') }}">{{ notification.cta|default('Abrir') }}</a>
                </li>
              {% endfor %}
            </ul>
          </article>

          <article class="nc-card nc-member-panel">
            <h3>Aniversariantes do dia</h3>
            <p class="nc-member-subtitle">Celebre com fraternidade os membros que fazem aniversario hoje.</p>

            {% if member_birthday_members|default([])|length > 0 %}
              <ul class="nc-member-birthday-list">
                {% for birthday_member in member_birthday_members %}
                  <li class="{{ birthday_member.is_current_member ? 'is-current-member' : '' }}">
                    <div class="nc-member-birthday-person">
                      <span class="nc-member-birthday-avatar" aria-hidden="true">
                        {% set birthday_photo_path = birthday_member.profile_photo_path|default('')|trim %}
                        {% if birthday_photo_path %}
                          <img src="{{ member_profile_photo_url(birthday_photo_path, base_url ?? '') }}" alt="">
                        {% else %}
                          <span>{{ birthday_member.initial|default('M') }}</span>
                        {% endif %}
                      </span>
                      <div>
                        <strong>{{ birthday_member.display_name|default(birthday_member.full_name|default('Membro')) }}</strong>
                        <p>{{ birthday_member.caption|default('Aniversaria hoje.') }}</p>
                      </div>
                    </div>
                    {% if birthday_member.is_current_member %}
                      <span class="nc-member-birthday-badge">Voce</span>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <p class="nc-member-empty">Hoje nao ha aniversariantes cadastrados na area do membro.</p>
            {% endif %}
          </article>

          <article class="nc-card nc-member-panel">
            <h3>Resumo semanal</h3>
            <p class="nc-member-subtitle">Veja rapidamente como está seu momento atual na área do membro.</p>

            <ul class="nc-member-weekly-highlights">
              {% for highlight in member_weekly_highlights|default([]) %}
                <li>
                  <span>{{ highlight.label }}</span>
                  <strong>{{ highlight.value }}</strong>
                </li>
              {% endfor %}
            </ul>

            <div class="nc-member-weekly-focus">
              <h4>{{ member_weekly_focus.title|default('Leitura do momento') }}</h4>
              <p>{{ member_weekly_focus.description|default('Seu painel está em dia. Continue acompanhando a agenda e as novidades da casa.') }}</p>
            </div>
          </article>

          <article class="nc-card nc-member-panel">
            <h3>Meu calendário pessoal</h3>
            <p class="nc-member-subtitle">Marque presença nas atividades e acompanhe seus próximos compromissos.</p>

            {% if member_my_upcoming_events|default([])|length > 0 %}
              <ul class="nc-member-my-events-list">
                {% for event in member_my_upcoming_events %}
                  <li>
                    <div>
                      <strong>{{ event.title|default('Atividade') }}</strong>
                      <p>{{ event.starts_at_label|default('Data a confirmar') }}</p>
                    </div>
                    <div class="nc-member-my-events-actions">
                      <a class="nc-link" href="/agenda/{{ event.slug|default('') }}">Detalhes</a>
                      <a class="nc-link" href="/agenda/{{ event.slug|default('') }}/ics">Baixar .ics</a>
                      {% if event.google_calendar_url|default('') %}
                        <a class="nc-link" href="{{ event.google_calendar_url }}" target="_blank" rel="noopener noreferrer">Google Agenda</a>
                      {% endif %}
                    </div>
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <p class="nc-member-empty">Você ainda não marcou participação em eventos.</p>
            {% endif %}
          </article>

          <article class="nc-card nc-member-panel nc-member-onboarding-panel">
            <h3>Onboarding do membro</h3>
            <p class="nc-member-subtitle">Acompanhe o progresso da sua conta, entenda o que ainda falta e avance com mais clareza.</p>

            <div class="nc-member-onboarding-overview">
              <div class="nc-member-onboarding-copy">
                <span class="nc-member-onboarding-status {{ member_onboarding_status_tone|default('is-progress') }}">{{ member_onboarding_status_label|default('Em andamento') }}</span>
                <strong class="nc-member-onboarding-headline">{{ member_onboarding_headline|default('Sua jornada na área do membro continua evoluindo.') }}</strong>
                <p class="nc-member-onboarding-description">{{ member_onboarding_description|default('Conclua as etapas pendentes para ativar uma experiência mais completa.') }}</p>
              </div>

              <dl class="nc-member-onboarding-metrics" aria-label="Resumo do onboarding">
                <div>
                  <dt>Concluídas</dt>
                  <dd>{{ member_onboarding_completed|default(0) }}</dd>
                </div>
                <div>
                  <dt>Pendentes</dt>
                  <dd>{{ member_onboarding_pending_count|default(0) }}</dd>
                </div>
                <div>
                  <dt>Progresso</dt>
                  <dd>{{ member_onboarding_percent|default(0) }}%</dd>
                </div>
              </dl>
            </div>

            <div class="nc-member-onboarding-progress" role="status" aria-live="polite">
              <div class="nc-member-onboarding-progress-copy">
                <strong>{{ member_onboarding_completed|default(0) }}/{{ member_onboarding_total|default(0) }} etapas concluídas</strong>
                <p>
                  {% if member_onboarding_pending_count|default(0) > 0 %}
                    Faltam {{ member_onboarding_pending_count|default(0) }} etapa{{ member_onboarding_pending_count|default(0) == 1 ? '' : 's' }} para fechar seu cadastro essencial.
                  {% else %}
                    Seu cadastro essencial já está completo e pronto para o uso cotidiano.
                  {% endif %}
                </p>
              </div>
              <div class="nc-member-onboarding-bar" aria-hidden="true">
                <span style="width: {{ member_onboarding_percent|default(0) }}%;"></span>
              </div>
            </div>

            <div class="nc-member-onboarding-layout">
              <div class="nc-member-onboarding-checklist-panel">
                <div class="nc-member-onboarding-section-head">
                  <h4>Etapas do cadastro</h4>
                  <p>Veja o que já está resolvido e o que ainda precisa de atenção no seu perfil.</p>
                </div>

                <ul class="nc-member-checklist nc-member-onboarding-checklist-detailed">
                  {% for item in member_onboarding_checklist|default([]) %}
                    <li class="{{ item.done ? 'is-done' : 'is-pending' }}">
                      <span class="nc-member-check-indicator" aria-hidden="true">{{ item.done ? '✓' : '•' }}</span>
                      <div class="nc-member-check-content">
                        <strong>{{ item.label }}</strong>
                        {% if item.description|default('') %}
                          <p>{{ item.description }}</p>
                        {% endif %}
                      </div>
                      <span class="nc-member-check-status">{{ item.done ? 'Concluído' : 'Pendente' }}</span>
                    </li>
                  {% endfor %}
                </ul>
              </div>

              <aside class="nc-member-onboarding-side">
                <div class="nc-member-onboarding-side-card">
                  <span class="nc-member-onboarding-side-kicker">Próximo passo recomendado</span>
                  <strong>{{ member_onboarding_recommended_step_title|default('Revisar seu painel') }}</strong>
                  <p>{{ member_onboarding_recommended_step_description|default('Use o próximo passo para manter seu cadastro consistente.') }}</p>
                </div>

                <div class="nc-member-onboarding-side-card">
                  <span class="nc-member-onboarding-side-kicker">O que melhora ao concluir</span>
                  <ul class="nc-member-onboarding-benefits">
                    {% for benefit in member_onboarding_benefits|default([]) %}
                      <li>{{ benefit }}</li>
                    {% endfor %}
                  </ul>
                </div>

                <div class="nc-actions nc-admin-login-actions nc-member-actions nc-member-onboarding-actions">
                  <a class="nc-btn nc-btn-primary nc-btn-block-mobile" href="{{ member_onboarding_primary_action.href|default('/membro/perfil/completar') }}">{{ member_onboarding_primary_action.label|default('Completar perfil') }}</a>
                  <a class="nc-btn nc-btn-secondary nc-btn-block-mobile" href="{{ member_onboarding_secondary_action.href|default('/membro') }}">{{ member_onboarding_secondary_action.label|default('Atualizar painel') }}</a>
                </div>
              </aside>
            </div>
          </article>

          <article class="nc-card nc-member-panel">
            <h3>O que fazer agora</h3>
            <p class="nc-member-subtitle">Próximas ações sugeridas para sua jornada na área de membro.</p>

            {% if member_next_actions|default([])|length > 0 %}
              <ul class="nc-member-next-actions">
                {% for action in member_next_actions %}
                  <li>
                    <strong>{{ action.title }}</strong>
                    <p>{{ action.description }}</p>
                    <a class="nc-link" href="{{ action.href }}">Ir para ação</a>
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <p class="nc-member-empty">Tudo certo por aqui. Seu painel não possui pendências imediatas.</p>
            {% endif %}

            {% if member_upcoming_events|default([])|length > 0 %}
              <div class="nc-member-upcoming-block">
                <h4>Próximos eventos</h4>
                <ul class="nc-member-upcoming-events">
                  {% for event in member_upcoming_events %}
                    <li>
                      <strong>{{ event.title|default('Atividade') }}</strong>
                      <span>{{ event.starts_at_label|default('Data a confirmar') }}</span>
                      <div class="nc-member-upcoming-actions">
                        <a class="nc-link" href="/agenda/{{ event.slug|default('') }}">Ver detalhes</a>
                        <a class="nc-link" href="/agenda/{{ event.slug|default('') }}/ics">Baixar .ics</a>
                        <form method="post" action="/membro/eventos/{{ event.id|default(0) }}/participacao">
                          {% include 'components/csrf-field.twig' %}
                          <input type="hidden" name="redirect_to" value="/membro">
                          <input type="hidden" name="intent" value="{{ event.member_interested|default(false) ? 'remove' : 'add' }}">
                          <button class="nc-link nc-link-button" type="submit">
                            {{ event.member_interested|default(false) ? 'Não vou' : 'Quero participar' }}
                          </button>
                        </form>
                      </div>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% else %}
              <p class="nc-member-empty">Nenhum evento publicado no momento. Acompanhe a agenda para novidades.</p>
            {% endif %}
          </article>

          <article class="nc-card nc-member-panel">
            <h3>Últimas movimentações</h3>
            <p class="nc-member-subtitle">Acompanhe aqui apenas as ações que você acabou de realizar na sua conta.</p>
            {% if member_recent_timeline|default([])|length > 0 %}
              <ul class="nc-member-history-list">
                {% for entry in member_recent_timeline|default([]) %}
                  <li>
                    <div>
                      <strong>{{ entry.title }}</strong>
                      <p>{{ entry.detail }}</p>
                    </div>
                    <span>{{ entry.meta }}</span>
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <p class="nc-member-empty">Nenhuma movimentação recente registrada nesta sessão.</p>
            {% endif %}
          </article>

          <article class="nc-card nc-member-panel">
            <h3>Permissões e trilhas de acesso</h3>
            <p class="nc-member-subtitle">Veja claramente o que já está liberado e o que depende de novo papel.</p>
            <ul class="nc-member-access-list nc-member-permission-list">
              {% for permission in member_permission_feedback|default([]) %}
                <li class="{{ permission.unlocked ? 'is-unlocked' : 'is-locked' }}">
                  <div>
                    <strong>{{ permission.title }}</strong>
                    <p>{{ permission.reason }}</p>
                  </div>
                  {% if permission.unlocked %}
                    <a class="nc-link" href="{{ permission.href }}">Acessar</a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </article>
        </section>
      </div>
    </section>
  </main>
{% endblock %}
