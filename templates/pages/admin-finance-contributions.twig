{% extends 'layouts/admin-dashboard.twig' %}

{% set dashboard_page_kicker = 'Finanças' %}
{% set dashboard_page_title = 'Contribuições dos associados contribuintes' %}
{% set dashboard_page_lead = 'Gere cobranças mensais, acompanhe adimplência e registre baixas manuais apenas para os associados marcados como contribuintes.' %}

{% block admin_content %}
  <section class="nc-section" aria-label="Controle financeiro das contribuições mensais" data-aos="fade-up" data-aos-delay="0">
    {% include 'components/admin-toast.twig' with {
      message: finance_contributions_toast_message|default(''),
      tone: finance_contributions_toast_tone|default('success')
    } %}

    {% set finance_base_url = base_url ?? '' %}
    {% set filters = finance_contributions_filters|default({}) %}
    {% set summary = finance_contributions_summary|default({}) %}
    {% set status_options = finance_contributions_status_options|default({}) %}
    {% set payment_methods = finance_contributions_payment_methods|default({}) %}
    {% set has_active_filters = filters.q|default('') != ''
      or filters.status_filter|default('all') != 'all'
      or filters.competence|default('') != ('now'|date('Y-m')) %}

    <div class="nc-actions nc-bookshop-toolbar" data-aos="fade-up" data-aos-delay="60">
      <a class="nc-btn nc-btn-secondary nc-btn-back" href="{{ finance_base_url }}/painel">Voltar ao painel</a>
      <form class="nc-admin-inline-form" method="post" action="{{ finance_base_url }}/painel/financas/contribuicoes/gerar">
        {% include 'components/csrf-field.twig' %}
        <input type="hidden" name="competence" value="{{ filters.competence|default('now'|date('Y-m')) }}">
        <button class="nc-btn nc-btn-secondary" type="submit">Gerar cobranças da competência</button>
      </form>
    </div>

    {% set contribution_kpi_cards = [
      {
        label: 'Contribuintes acompanhados',
        value: summary.tracked_count|default(0),
        description: summary.not_generated_count|default(0) ~ ' aguardando geração e ' ~ summary.config_pending_count|default(0) ~ ' com configuração financeira pendente.',
        icon_svg: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 19C16 16.7909 14.2091 15 12 15C9.79086 15 8 16.7909 8 19" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="9" r="3" stroke="currentColor" stroke-width="1.7"/><path d="M18 10.5C19.1046 10.5 20 9.60457 20 8.5C20 7.39543 19.1046 6.5 18 6.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M4 10.5C2.89543 10.5 2 9.60457 2 8.5C2 7.39543 2.89543 6.5 4 6.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>'
      },
      {
        label: 'Montante gerado',
        value: summary.generated_total_label|default('R$ 0,00'),
        description: 'Cobranças geradas para ' ~ summary.competence_label|default('a competência selecionada') ~ '.',
        icon_svg: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 5.25V18.75" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M15.5 8.25C15.5 6.86929 13.9325 5.75 12 5.75C10.0675 5.75 8.5 6.86929 8.5 8.25C8.5 9.63071 10.0675 10.75 12 10.75C13.9325 10.75 15.5 11.8693 15.5 13.25C15.5 14.6307 13.9325 15.75 12 15.75C10.0675 15.75 8.5 14.6307 8.5 13.25" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>'
      },
      {
        label: 'Recebido',
        value: summary.received_total_label|default('R$ 0,00'),
        description: summary.good_standing_count|default(0) ~ ' associado' ~ (summary.good_standing_count|default(0) == 1 ? '' : 's') ~ ' em dia dentro do recorte.',
        icon_svg: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.75 17.75L9 12.75L12 15.25L18.75 7.25" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M15.75 7.25H18.75V10.25" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>'
      },
      {
        label: 'Inadimplentes',
        value: summary.overdue_count|default(0),
        description: 'Em aberto no recorte: ' ~ summary.open_total_label|default('R$ 0,00') ~ '.',
        icon_svg: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 7V12.25L15 14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="7.25" stroke="currentColor" stroke-width="1.7"/></svg>'
      }
    ] %}
    <section class="nc-dashboard-visit-panel" aria-label="Indicadores das contribuições" data-aos="fade-up" data-aos-delay="90">
      <div class="nc-dashboard-visit-panel-head">
        <div>
          <h3 class="nc-dashboard-visit-panel-title">Painel da competência {{ filters.competence_label|default(summary.competence_label|default('Atual')) }}</h3>
          <p class="nc-dashboard-visit-panel-copy">Os valores e contagens abaixo respeitam os filtros aplicados na listagem.</p>
        </div>
      </div>

      <div class="nc-dashboard-visit-grid">
        {% for card in contribution_kpi_cards %}
          {% include 'components/admin-kpi-card.twig' with {
            kpi_label: card.label,
            kpi_value: card.value,
            kpi_description: card.description,
            kpi_icon_svg: card.icon_svg
          } only %}
        {% endfor %}
      </div>
    </section>

    <form class="nc-admin-table-search" method="get" action="{{ finance_base_url }}/painel/financas/contribuicoes" data-aos="fade-up" data-aos-delay="120">
      <label for="nc-finance-contributions-search">Filtrar associados e cobranças</label>
      <div class="nc-admin-table-search-controls nc-bookshop-table-filters nc-finance-filter-controls">
        <input class="nc-admin-form-input" name="competence" type="month" value="{{ filters.competence|default('now'|date('Y-m')) }}" aria-label="Competência">
        <input id="nc-finance-contributions-search" name="q" type="search" value="{{ filters.q|default('') }}" placeholder="Nome, CPF, e-mail, tipo ou situação...">
        <select name="status_filter" aria-label="Filtrar por situação">
          {% for value, label in status_options %}
            <option value="{{ value }}"{% if filters.status_filter|default('all') == value %} selected{% endif %}>{{ label }}</option>
        {% endfor %}
        </select>
        <button class="nc-btn nc-btn-secondary" type="submit">Aplicar</button>
        {% if has_active_filters %}
          <a class="nc-btn nc-btn-secondary" href="{{ finance_base_url }}/painel/financas/contribuicoes">Limpar</a>
        {% endif %}
      </div>
    </form>

    <article class="nc-finance-period-inline-summary" data-aos="fade-up" data-aos-delay="140">
      <strong>Montante gerado no recorte: {{ summary.generated_total_label|default('R$ 0,00') }}</strong>
      <span>{{ summary.competence_label|default('Competência atual') }}</span>
      <span>Recebido {{ summary.received_total_label|default('R$ 0,00') }}</span>
      <span>Em aberto {{ summary.open_total_label|default('R$ 0,00') }}</span>
      <span>{{ summary.tracked_count_label|default('0 contribuintes') }}</span>
    </article>

    {% if finance_contributions|length == 0 %}
      <article class="nc-card nc-bookshop-empty-card" data-aos="fade-up" data-aos-delay="160">
        <p>{{ has_active_filters ? 'Nenhum contribuinte encontrado para os filtros informados.' : 'Nenhuma cobrança mensal gerada ainda para a competência selecionada.' }}</p>
      </article>
    {% else %}
      <div class="nc-admin-table-wrap" data-aos="fade-up" data-aos-delay="160">
        <table class="nc-admin-table nc-admin-table-bookshop nc-finance-contributions-table">
          <thead>
            <tr>
              <th>Foto</th>
              <th>Contribuinte</th>
              <th>Tipo</th>
              <th>Competência e vencimento</th>
              <th>Valor</th>
              <th>Situação</th>
              <th>Cobrança</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            {% for contribution in finance_contributions %}
              <tr>
                <td class="nc-admin-user-photo-cell nc-contribution-photo-cell" data-label="Foto">
                  <span class="nc-admin-user-photo nc-contribution-photo" aria-hidden="true">
                    {% set contribution_photo_path = contribution.profile_photo_path|default('')|trim %}
                    {% if contribution_photo_path %}
                      <img src="{{ (base_url ?? '') ~ '/' ~ (contribution_photo_path|trim('/')) }}" alt="">
                    {% else %}
                      <span>{{ (contribution.full_name|default(contribution.email|default('U'))|slice(0, 1)|upper) }}</span>
                    {% endif %}
                  </span>
                </td>
                <td class="nc-agenda-activity-cell" data-label="Contribuinte">
                  <strong>{{ contribution.full_name|default(contribution.email|default('Contribuinte')) }}</strong>
                  {% if contribution.cpf_display|default('') and contribution.cpf_display != '-' %}
                    <small>{{ contribution.cpf_display }}</small>
                  {% endif %}
                  <small>{{ contribution.email|default('-') }}</small>
                </td>
                <td class="nc-agenda-activity-cell" data-label="Tipo">
                  <strong>{{ contribution.member_type_label|default('Não definido') }}</strong>
                  <small>{{ contribution.institutional_role_display|default('Sem função diretiva') }}</small>
                </td>
                <td class="nc-agenda-activity-cell" data-label="Competência e vencimento">
                  <strong>{{ contribution.charge_competence_label|default(filters.competence_label|default('-')) }}</strong>
                  <small>
                    {% if contribution.has_current_charge %}
                      Vencimento {{ contribution.due_date_display|default('-') }}
                    {% elseif contribution.preferred_due_day|default(0) > 0 %}
                      Vencimento dia {{ '%02d'|format(contribution.preferred_due_day|default(0)) }}
                    {% else %}
                      Vencimento ainda não definido
                    {% endif %}
                  </small>
                </td>
                <td class="nc-agenda-activity-cell" data-label="Valor">
                  <strong>{{ contribution.amount_due_display|default('Não definido') }}</strong>
                  {% if contribution.contribution_plan_label|default('') %}
                    <small>{{ contribution.contribution_plan_label }}</small>
                  {% endif %}
                </td>
                <td class="nc-agenda-activity-cell" data-label="Situação">
                  <span class="nc-admin-featured-flag {{ contribution.status_tone|default('is-off') }}">{{ contribution.status_label|default('Não definido') }}</span>
                  {% for note in contribution.status_notes|default([]) %}
                    <small>{{ note }}</small>
                  {% endfor %}
                </td>
                <td class="nc-agenda-activity-cell" data-label="Cobrança">
                  <strong>{{ contribution.payment_method_display|default('Pagamento manual') }}</strong>
                  {% if contribution.has_gateway_charge %}
                    <small>
                      <span class="nc-admin-featured-flag {{ contribution.gateway_status_tone|default('is-info') }}">{{ contribution.gateway_billing_type_label|default('Cobrança') }} · {{ contribution.gateway_status_label|default('Sem status') }}</span>
                    </small>
                  {% endif %}
                  {% for note in contribution.contact_notes|default([]) %}
                    <small>{{ note }}</small>
                  {% endfor %}
                </td>
                <td class="nc-admin-table-actions nc-contribution-actions" data-label="Ações">
                  {% if contribution.can_mark_paid %}
                    {% if contribution.has_gateway_charge %}
                      <a class="nc-btn nc-btn-secondary" href="{{ finance_base_url }}/painel/financas/contribuicoes/{{ contribution.charge_id }}/cobranca">Detalhes da cobrança</a>
                      <form class="nc-admin-inline-form" method="post" action="{{ finance_base_url }}/painel/financas/contribuicoes/{{ contribution.charge_id }}/cobranca/sincronizar">
                        {% include 'components/csrf-field.twig' %}
                        <button class="nc-btn nc-btn-secondary" type="submit">Sincronizar</button>
                      </form>
                    {% else %}
                      <form class="nc-admin-inline-form" method="post" action="{{ finance_base_url }}/painel/financas/contribuicoes/{{ contribution.charge_id }}/cobranca/criar">
                        {% include 'components/csrf-field.twig' %}
                        <input type="hidden" name="competence" value="{{ filters.competence|default('now'|date('Y-m')) }}">
                        <input type="hidden" name="billing_type" value="pix">
                        <button class="nc-btn nc-btn-secondary" type="submit">Gerar Pix</button>
                      </form>
                      <form class="nc-admin-inline-form" method="post" action="{{ finance_base_url }}/painel/financas/contribuicoes/{{ contribution.charge_id }}/cobranca/criar">
                        {% include 'components/csrf-field.twig' %}
                        <input type="hidden" name="competence" value="{{ filters.competence|default('now'|date('Y-m')) }}">
                        <input type="hidden" name="billing_type" value="boleto">
                        <button class="nc-btn nc-btn-secondary" type="submit">Gerar boleto</button>
                      </form>
                    {% endif %}
                    <form class="nc-admin-inline-form" method="post" action="{{ finance_base_url }}/painel/financas/contribuicoes/{{ contribution.charge_id }}/receber">
                      {% include 'components/csrf-field.twig' %}
                      <input type="hidden" name="competence" value="{{ filters.competence|default('now'|date('Y-m')) }}">
                      <select class="nc-admin-inline-select" name="payment_method" aria-label="Forma de baixa">
                        {% for value, label in payment_methods %}
                          <option value="{{ value }}"{% if contribution.payment_method_key|default('manual') == value %} selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                      </select>
                      <button class="nc-btn nc-btn-secondary" type="submit">Registrar recebimento</button>
                    </form>
                    <form class="nc-admin-inline-form" method="post" action="{{ finance_base_url }}/painel/financas/contribuicoes/{{ contribution.charge_id }}/isentar">
                      {% include 'components/csrf-field.twig' %}
                      <input type="hidden" name="competence" value="{{ filters.competence|default('now'|date('Y-m')) }}">
                      <button class="nc-btn nc-btn-secondary" type="submit">Isentar</button>
                    </form>
                    {% if contribution.can_send_email_reminder %}
                      <form class="nc-admin-inline-form" method="post" action="{{ finance_base_url }}/painel/financas/contribuicoes/{{ contribution.charge_id }}/enviar-email">
                        {% include 'components/csrf-field.twig' %}
                        <input type="hidden" name="competence" value="{{ filters.competence|default('now'|date('Y-m')) }}">
                        <button class="nc-btn nc-btn-secondary" type="submit">Enviar e-mail</button>
                      </form>
                    {% endif %}
                    {% if contribution.can_open_whatsapp_reminder %}
                      <a class="nc-btn nc-btn-secondary" href="{{ finance_base_url }}/painel/financas/contribuicoes/{{ contribution.charge_id }}/whatsapp?competence={{ filters.competence|default('now'|date('Y-m'))|url_encode }}" target="_blank" rel="noopener">WhatsApp</a>
                    {% endif %}
                    {% if not contribution.can_send_email_reminder and not contribution.can_open_whatsapp_reminder %}
                      <span class="nc-contribution-action-note">Sem autorização ou contato válido para lembretes.</span>
                    {% endif %}
                  {% elseif contribution.has_current_charge and contribution.has_gateway_charge %}
                    <a class="nc-btn nc-btn-secondary" href="{{ finance_base_url }}/painel/financas/contribuicoes/{{ contribution.charge_id }}/cobranca">Detalhes da cobrança</a>
                  {% elseif contribution.has_current_charge %}
                    <span class="nc-admin-featured-flag {{ contribution.status_tone|default('is-off') }}">Sem ação manual</span>
                  {% elseif contribution.status_key|default('') == 'config_pending' %}
                    <span class="nc-contribution-action-note">Completar cadastro financeiro antes de gerar a cobrança.</span>
                  {% else %}
                    <span class="nc-contribution-action-note">Use o botão acima para gerar a cobrança desta competência.</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </section>
{% endblock %}
