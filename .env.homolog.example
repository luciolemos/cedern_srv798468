# CEDE homologation environment example for https://homolog.cedern.org/
# Keep the real file outside Git when possible and fill only on the server.
# If you use APP_ENV_FILE, point Apache/Hostinger to the real file path.
# Runbook operacional: docs/HOMOLOGATION_ENVIRONMENT_RUNBOOK.md

# ============================================================================
# 1) Bootstrap and runtime
# ============================================================================

# Use production here on purpose. In the current runtime, APP_ENV=homolog is
# treated as development-like and does not mirror production strictly enough.
APP_ENV=production
APP_DEPLOY_STAGE="homolog"
APP_LOG_PATH="/home/u429418010/logs/cedern-homolog.log"
APP_ALLOW_REPOSITORY_FALLBACK="false"
APP_BASE=""
APP_ASSET_VERSION="1"
APP_ENABLE_DIAGNOSTIC_ROUTES="false"
APP_DIAGNOSTIC_TOKEN="troque_este_token"
APP_MANAGED_STORAGE_ROOT="/home/u429418010/_cedern_storage_homolog"
APP_MANAGED_STORAGE_IMPORT_ARCHIVE_DIR="/home/u429418010/_cedern_storage_homolog/imports/managed-storage-zips"
APP_ENABLE_LEGACY_MEDIA_FALLBACK="false"


# ============================================================================
# 2) Appearance and theme selector
# ============================================================================

APP_DEFAULT_THEME=amber
APP_DEFAULT_MODE=light
APP_DEFAULT_DARK_INTENSITY=neutral
APP_THEME_ALLOWED_THEMES="amber,blue,green,red,violet"
APP_THEME_ALLOWED_MODES="light,dark"
APP_THEME_ALLOWED_DARK_INTENSITIES="neutral,vivid"
APP_ENABLE_THEME_PALETTE="false"
APP_ENABLE_DASHBOARD_THEME_PALETTE="true"


# ============================================================================
# 3) Site metadata and social links
# ============================================================================

APP_DEFAULT_PAGE_TITLE="CEDE | Centro de Estudos da Doutrina Espirita"
APP_DEFAULT_PAGE_DESCRIPTION="Centro de Estudos da Doutrina Espirita (CEDE): instituicao filantropica dedicada ao estudo, a pratica e a divulgacao da Doutrina Espirita."
APP_DEFAULT_PAGE_URL="https://homolog.cedern.org/"
APP_DEFAULT_PAGE_IMAGE="https://homolog.cedern.org/assets/img/cedern/cede1_1600_1000.png"
APP_DEFAULT_SITE_NAME="CEDE"
APP_DEFAULT_TWITTER_SITE="@cedeoficialrn"
APP_SOCIAL_FACEBOOK_URL="https://www.facebook.com/cedern.oficial/"
APP_SOCIAL_INSTAGRAM_URL="https://www.instagram.com/cedern.oficial/"


# ============================================================================
# 4) Public agenda and diagnostics
# ============================================================================

APP_AGENDA_PUBLIC_LIMIT="12"


# ============================================================================
# 5) reCAPTCHA
# ============================================================================

RECAPTCHA_ENABLED="true"
RECAPTCHA_SITE_KEY="sua_chave_publica_homolog"
RECAPTCHA_SECRET_KEY="sua_chave_secreta_homolog"
RECAPTCHA_MIN_SCORE="0.1"
RECAPTCHA_ALLOWED_HOSTNAME="homolog.cedern.org"


# ============================================================================
# 6) MySQL database
# ============================================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=seu_banco_homolog
DB_USER=seu_usuario_homolog
DB_PASS="sua_senha_homolog"
DB_CHARSET=utf8mb4
DB_TIMEZONE=+00:00


# ============================================================================
# 7) Admin Agenda helper access
# ============================================================================

ADMIN_AGENDA_USER=admin
ADMIN_AGENDA_PASS="sua_senha_forte_homolog"


# ============================================================================
# 8) Public uploads and storage
# ============================================================================

LIBRARY_UPLOAD_DIR="var/storage/library/docs"
LIBRARY_UPLOAD_PUBLIC_PREFIX="media/biblioteca/docs"
LIBRARY_COVER_UPLOAD_DIR="var/storage/library/covers"
LIBRARY_COVER_UPLOAD_PUBLIC_PREFIX="media/biblioteca/capas"
BOOKSHOP_COVER_UPLOAD_DIR="var/storage/bookshop/covers"
BOOKSHOP_COVER_UPLOAD_PUBLIC_PREFIX="media/livraria/capas"
MEMBER_PROFILE_PHOTO_UPLOAD_DIR="var/storage/member-photos"
MEMBER_PROFILE_PHOTO_UPLOAD_PUBLIC_PREFIX="media/membros/fotos"
PATRIMONY_DOCUMENT_UPLOAD_DIR="var/storage/patrimony/docs"
PATRIMONY_DOCUMENT_UPLOAD_PUBLIC_PREFIX="media/patrimonio/docs"
PATRIMONY_IMAGE_UPLOAD_DIR="var/storage/patrimony/img"
PATRIMONY_IMAGE_UPLOAD_PUBLIC_PREFIX="media/patrimonio/img"


# ============================================================================
# 9) Asaas billing gateway
# ============================================================================

ASAAS_ENVIRONMENT=sandbox
ASAAS_ALLOW_PRODUCTION_IN_NON_PRODUCTION="false"
ASAAS_API_KEY="sua_api_key_homolog"
ASAAS_WEBHOOK_TOKEN="seu_webhook_token_homolog"
ASAAS_USER_AGENT="cedern-finance-homolog/1.0"
ASAAS_CUSTOMER_NOTIFICATION_DISABLED="true"


# ============================================================================
# 10) Transactional email
# ============================================================================

# Prefer a controlled mailbox for homologation to avoid confusing real users.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=homolog@cedern.org
MAIL_PASSWORD="sua_senha_smtp_homolog"
MAIL_FROM_ADDRESS=homolog@cedern.org
MAIL_FROM_NAME="CEDE - Homologacao"
MAIL_TO_ADDRESS=homolog@cedern.org
MAIL_PUBLIC_EMAIL=homolog@cedern.org
MAIL_ENCRYPTION=ssl
MAIL_TIMEOUT="15"
MAIL_SMTP_DEBUG="false"
MAIL_ALLOW_EXTERNAL_REPLYTO="false"
